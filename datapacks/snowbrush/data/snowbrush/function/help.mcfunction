tellraw @s [{"text":"清空模式：","color":"red"},{"text":"/trigger snow_mode set 3","color":"yellow"},{"text":"（将范围变为空气）","color":"gray"}]
tellraw @s [{"text":"调整半径：","color":"white"},{"text":"/trigger snow_size set 1..64","color":"yellow"},{"text":"，默认 3；25 以上请避免连续投掷","color":"gray"}]
