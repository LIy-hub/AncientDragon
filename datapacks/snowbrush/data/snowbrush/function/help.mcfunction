tellraw @s [{"text":"====== 雪球地形笔刷 ======","color":"aqua","bold":true}]
tellraw @s [{"text":"主手投雪球。球形/随机替换与生成需要副手方块；自然化允许副手为空。","color":"white"}]
tellraw @s [{"text":"替换模式：","color":"green"},{"text":"/trigger snow_mode set 1","color":"yellow"},{"text":"（只改自然地形）","color":"gray"}]
